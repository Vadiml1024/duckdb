+static QualifiedName ExtractProcedureName(const Value &value) {
+	auto procedure_name = value.GetValue<string>();
+	auto qualified_name = QualifiedName::Parse(procedure_name);
+	if (qualified_name.Name().empty()) {
+		throw BinderException("Procedure name cannot be empty");
+	}
+	if (!qualified_name.Catalog().empty() || qualified_name.Path().size() > 2) {
+		throw BinderException("Procedure name must be unqualified or schema-qualified");
+	}
+	return qualified_name;
+}
+
+static string CreateCallQuery(const QualifiedName &procedure_name, idx_t param_count) {
+	string query = "CALL ";
+	if (!procedure_name.Schema().empty()) {
+		query += MySQLUtils::WriteIdentifier(procedure_name.Schema().GetIdentifierName());
+		query += ".";
+	}
+	query += MySQLUtils::WriteIdentifier(procedure_name.Name().GetIdentifierName());
+	query += "(";
+	for (idx_t i = 0; i < param_count; i++) {
+		if (i > 0) {
+			query += ", ";
+		}
+		query += "?";
+	}
+	query += ")";
+	return query;
+}
+
+static idx_t GetProcedureParameterCount(MySQLConnection &conn, MySQLCatalog &catalog, const QualifiedName &procedure_name) {
+	string schema_name;
+	if (!procedure_name.Schema().empty()) {
+		schema_name = procedure_name.Schema().GetIdentifierName();
+	} else {
+		schema_name = catalog.GetAttachedDatabaseName();
+		if (schema_name.empty()) {
+			throw BinderException("mysql_call with params_handle requires a schema-qualified procedure name when the "
+			                      "attached MySQL database has no default schema");
+		}
+	}
+	vector<Value> metadata_params;
+	metadata_params.emplace_back(schema_name);
+	metadata_params.emplace_back(procedure_name.Name().GetIdentifierName());
+	auto metadata_result = conn.Query(
+	    "SELECT count(*)::BIGINT AS param_count FROM information_schema.parameters "
+	    "WHERE specific_schema = ? AND specific_name = ? AND ordinal_position > 0",
+	    metadata_params, MySQLResultStreaming::FORCE_MATERIALIZATION);
+	if (!metadata_result->Next()) {
+		throw InternalException("Failed to fetch procedure parameter count for \"%s\"", procedure_name.ToString());
+	}
+	return UnsafeNumericCast<idx_t>(metadata_result->GetInt64(0));
+}
