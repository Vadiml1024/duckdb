+static void StoreStatementResult(const string &query, MYSQL_STMT *stmt) {
+	bool btrue = true;
+	auto res_attr = mysql_stmt_attr_set(stmt, STMT_ATTR_UPDATE_MAX_LENGTH, &btrue);
+	if (res_attr != 0) {
+		throw IOException("Failed to set STMT_ATTR_UPDATE_MAX_LENGTH for MySQL query \"%s\": %s\n", query.c_str(),
+		                  mysql_stmt_error(stmt));
+	}
+
+	int res_store = mysql_stmt_store_result(stmt);
+	if (res_store != 0) {
+		throw IOException("Failed to store result for MySQL query \"%s\": %s\n", query.c_str(),
+		                  mysql_stmt_error(stmt));
+	}
+}
+
+static void TryDrainProcedureStatement(MYSQL_STMT *stmt) {
+	if (!stmt) {
+		return;
+	}
+	while (true) {
+		if (mysql_stmt_field_count(stmt) > 0) {
+			bool btrue = true;
+			if (mysql_stmt_attr_set(stmt, STMT_ATTR_UPDATE_MAX_LENGTH, &btrue) != 0) {
+				return;
+			}
+			if (mysql_stmt_store_result(stmt) != 0) {
+				return;
+			}
+		}
+		mysql_stmt_free_result(stmt);
+		int next_result = mysql_stmt_next_result(stmt);
+		if (next_result != 0) {
+			return;
+		}
+	}
+}
+
+static unique_ptr<MySQLResult> CreateProcedureResult(const string &query, MySQLStatementPtr stmt,
+                                                     const MySQLTypeConfig &type_config,
+                                                     const string &connection_string, unsigned long connection_id,
+                                                     MySQLResultStreaming streaming, idx_t affected_rows,
+                                                     vector<MySQLField> fields,
+                                                     MySQLResultStatementLifetime stmt_lifetime,
+                                                     bool current_result_stored) {
+	try {
+		while (true) {
+			if (mysql_stmt_field_count(stmt.get()) > 0) {
+				if (fields.empty()) {
+					fields = MySQLField::ReadFields(query, stmt.get(), type_config);
+				}
+				if (!current_result_stored && streaming != MySQLResultStreaming::ALLOW_STREAMING) {
+					StoreStatementResult(query, stmt.get());
+				}
+				return make_uniq<MySQLResult>(query, std::move(stmt), type_config, connection_string, connection_id,
+				                              streaming, idx_t(-1), std::move(fields), stmt_lifetime, true);
+			}
+
+			fields.clear();
+			affected_rows = mysql_stmt_affected_rows(stmt.get());
+			mysql_stmt_free_result(stmt.get());
+
+			int next_result = mysql_stmt_next_result(stmt.get());
+			if (next_result < 0) {
+				return make_uniq<MySQLResult>(query, std::move(stmt), type_config, connection_string, connection_id,
+				                              streaming, affected_rows, vector<MySQLField>(), stmt_lifetime);
+			}
+			if (next_result > 0) {
+				throw IOException("Failed to fetch next result for MySQL query \"%s\": %s\n", query.c_str(),
+				                  mysql_stmt_error(stmt.get()));
+			}
+			current_result_stored = false;
+		}
+	} catch (...) {
+		TryDrainProcedureStatement(stmt.get());
+		throw;
+	}
+}
