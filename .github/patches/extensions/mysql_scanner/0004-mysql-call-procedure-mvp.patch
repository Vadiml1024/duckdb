+unique_ptr<MySQLResult> MySQLConnection::QueryProcedureStmt(MySQLStatement &stmt, const vector<Value> &params,
+                                                            MySQLResultStreaming streaming) {
+	if (streaming == MySQLResultStreaming::ALLOW_STREAMING) {
+		throw BinderException("Procedure result streaming is not supported");
+	}
+
+	bool prepared = true;
+	idx_t rowcount = MySQLExecute(stmt.get(), stmt.Query(), params, false, prepared);
+	idx_t first_rowcount = rowcount;
+	while (rowcount != static_cast<idx_t>(-1)) {
+		int next_result = mysql_stmt_next_result(stmt.get());
+		if (next_result > 0) {
+			ThrowNextResultError(stmt.get(), stmt.Query());
+		}
+		if (next_result < 0) {
+			break;
+		}
+		rowcount = mysql_stmt_affected_rows(stmt.get());
+		if (rowcount != static_cast<idx_t>(-1)) {
+			first_rowcount = rowcount;
+			continue;
+		}
+		StoreStatementResult(stmt.get(), stmt.Query());
+	}
+
+	MYSQL_STMT *stmt_ptr_bare = stmt.get();
+	MySQLStatementPtr stmt_ptr(stmt_ptr_bare, MySQLStatementDelete);
+	unsigned long connection_id = connection->GetID();
+	if (rowcount == static_cast<idx_t>(-1)) {
+		auto fields = MySQLField::ReadFields(stmt.Query(), stmt.get(), type_config);
+		return make_uniq<MySQLResult>(stmt.Query(), std::move(stmt_ptr), type_config, connection_string, connection_id,
+		                              streaming, rowcount, std::move(fields), MySQLResultStatementLifetime::BORROWED);
+	}
+	return make_uniq<MySQLResult>(stmt.Query(), std::move(stmt_ptr), type_config, connection_string, connection_id,
+	                              streaming, first_rowcount, vector<MySQLField>(),
+	                              MySQLResultStatementLifetime::BORROWED);
+}
+
+unique_ptr<MySQLResult> MySQLConnection::QueryProcedure(const string &query, const vector<Value> &params,
+                                                        MySQLResultStreaming streaming) {
+	if (streaming == MySQLResultStreaming::ALLOW_STREAMING) {
+		throw BinderException("Procedure result streaming is not supported");
+	}
+
+	auto con = GetConn();
+	auto stmt = MySQLStatementPtr(nullptr, MySQLStatementDelete);
+	{
+		lock_guard<mutex> guard(query_lock);
+		stmt = MySQLStatementPtr(mysql_stmt_init(con), MySQLStatementDelete);
+		if (!stmt) {
+			throw IOException("Failed to initialize MySQL query \"%s\": %s\n", query.c_str(), mysql_error(con));
+		}
+	}
+
+	idx_t rowcount = MySQLExecute(stmt.get(), query, params, false);
+	idx_t first_rowcount = rowcount;
+	while (rowcount != static_cast<idx_t>(-1)) {
+		int next_result = mysql_stmt_next_result(stmt.get());
+		if (next_result > 0) {
+			ThrowNextResultError(stmt.get(), query);
+		}
+		if (next_result < 0) {
+			break;
+		}
+		rowcount = mysql_stmt_affected_rows(stmt.get());
+		if (rowcount != static_cast<idx_t>(-1)) {
+			first_rowcount = rowcount;
+			continue;
+		}
+		StoreStatementResult(stmt.get(), query);
+	}
+
+	unsigned long connection_id = connection->GetID();
+	if (rowcount == static_cast<idx_t>(-1)) {
+		auto fields = MySQLField::ReadFields(query, stmt.get(), type_config);
+		return make_uniq<MySQLResult>(query, std::move(stmt), type_config, connection_string, connection_id, streaming,
+		                              rowcount, std::move(fields));
+	}
+	return make_uniq<MySQLResult>(query, std::move(stmt), type_config, connection_string, connection_id, streaming,
+	                              first_rowcount, vector<MySQLField>());
+}
