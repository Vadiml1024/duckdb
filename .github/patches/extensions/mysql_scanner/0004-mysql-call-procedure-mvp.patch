+static string BuildProcedureIdentifier(const string &procedure_name) {
+	vector<string> parts;
+	string current;
+	for (auto ch : procedure_name) {
+		if (ch == '.') {
+			if (current.empty()) {
+				throw BinderException("Stored procedure name is invalid: \"%s\"", procedure_name);
+			}
+			parts.push_back(current);
+			current.clear();
+			continue;
+		}
+		current.push_back(ch);
+	}
+	if (current.empty()) {
+		throw BinderException("Stored procedure name is invalid: \"%s\"", procedure_name);
+	}
+	parts.push_back(current);
+
+	string result;
+	for (idx_t i = 0; i < parts.size(); i++) {
+		if (i > 0) {
+			result += ".";
+		}
+		result += MySQLUtils::WriteIdentifier(parts[i]);
+	}
+	return result;
+}
+
+static string BuildCallQuery(const string &procedure_name, idx_t param_count) {
+	string query = "CALL ";
+	query += BuildProcedureIdentifier(procedure_name);
+	query += "(";
+	for (idx_t i = 0; i < param_count; i++) {
+		if (i > 0) {
+			query += ", ";
+		}
+		query += "?";
+	}
+	query += ")";
+	return query;
+}
+
+static unique_ptr<FunctionData> MySQLCallBind(ClientContext &context, TableFunctionBindInput &input,
+                                               vector<LogicalType> &return_types, vector<Identifier> &names) {
+	if (input.inputs[0].IsNull() || input.inputs[1].IsNull()) {
+		throw BinderException("Parameters to mysql_call cannot be NULL");
+	}
+
+	string db_name = input.inputs[0].GetValue<string>();
+	MySQLCatalog &catalog = GetCatalogByName(context, db_name);
+	string procedure_name = input.inputs[1].GetValue<string>();
+	if (procedure_name.empty()) {
+		throw BinderException("Stored procedure name cannot be empty");
+	}
+
+	vector<Value> params = ExtractParams(input);
+	int64_t params_handle = ExtractParamsHandle(input);
+	uint64_t pinned_connection_id = ExtractPinnedConnId(input);
+	if (ExtractUserStreaming(input) == MySQLResultStreamingUser::REQUIRE_STREAMING) {
+		throw BinderException("Query result streaming cannot be used with 'mysql_call'");
+	}
+
+	string call_query = BuildCallQuery(procedure_name, params.size());
+
+	bool tran_restrict_dml = false;
+	try {
+		optional_ptr<MySQLConnection> conn_ptr = nullptr;
+		MySQLPooledConnection pinned_connection;
+		uint64_t prepare_connection_id = 0;
+		if (pinned_connection_id > 0) {
+			pinned_connection = catalog.GetConnectionPool().UnpinConnection(pinned_connection_id);
+			MySQLConnection &conn = pinned_connection.GetConnection();
+			conn_ptr = &conn;
+			prepare_connection_id = pinned_connection.Id();
+		} else {
+			MySQLTransaction &transaction = MySQLTransaction::Get(context, catalog);
+			MySQLConnection &conn = transaction.GetConnection();
+			conn_ptr = &conn;
+			prepare_connection_id = transaction.GetConnectionId();
+			tran_restrict_dml = transaction.GetAccessMode() == AccessMode::READ_ONLY;
+		}
+
+		auto deferred_pin = dbconnector::Defer([&pinned_connection, &catalog] {
+			if (!pinned_connection) {
+				return;
+			}
+			try {
+				catalog.GetConnectionPool().PinConnection(std::move(pinned_connection));
+			} catch (...) {
+				// suppress
+			}
+		});
+
+		if (tran_restrict_dml) {
+			throw PermissionException("statements that do not produce result sets cannot be run in a read-only connection");
+		}
+
+		MySQLConnection &conn = *conn_ptr;
+		unique_ptr<MySQLStatement> stmt = conn.Prepare(call_query);
+		auto fields = stmt->FieldsCopy();
+		if (fields.empty()) {
+			return_types.emplace_back(LogicalType::BIGINT);
+			names.emplace_back("rowcount");
+			return make_uniq<MySQLCallBindData>(catalog, std::move(procedure_name), std::move(call_query),
+			                                   std::move(params), params_handle, pinned_connection_id);
+		}
+
+		for (auto &field : fields) {
+			names.push_back(Identifier(field.name));
+			return_types.push_back(field.duckdb_type);
+		}
+		QueryResult::DeduplicateColumns(names);
+		return make_uniq<MySQLCallBindData>(catalog, std::move(procedure_name), std::move(call_query),
+		                                   std::move(params), params_handle, std::move(fields), std::move(stmt),
+		                                   prepare_connection_id, pinned_connection_id);
+	} catch (const std::exception &ex) {
+		ErrorData error(ex);
+		throw BinderException("CALL PREPARE error, procedure: \"%s\", message: \"%s\"", procedure_name,
+		                      error.RawMessage());
+	}
+}
+
+static unique_ptr<GlobalTableFunctionState> MySQLCallInitGlobalState(ClientContext &ctx,
+                                                                      TableFunctionInitInput &input) {
+	auto &bdata = input.bind_data->CastNoConst<MySQLCallBindData>();
+	MySQLPooledConnection pinned_connection;
+	if (bdata.pinned_connection_id > 0) {
+		auto attached_catalog = MySQLCatalog::Lookup(ctx, bdata.catalog_name);
+		MySQLCatalog &catalog = attached_catalog.Get<MySQLCatalog>();
+		pinned_connection = catalog.GetConnectionPool().UnpinConnection(bdata.pinned_connection_id);
+	}
+	return make_uniq<MySQLGlobalState>(std::move(pinned_connection));
+}
+
+static const vector<Value> &ResolveParams(const MySQLCallBindData &bdata, MySQLGlobalState &gstate) {
+	if (bdata.params_handle == 0) {
+		return bdata.params;
+	}
+	auto params_ptr = MySQLParameterHandles::Remove(bdata.params_handle);
+	if (params_ptr.get() == nullptr) {
+		throw BinderException("Parameters not found, ID: %lld", bdata.params_handle);
+	}
+	gstate.params.clear();
+	for (Value &par : *params_ptr) {
+		gstate.params.emplace_back(std::move(par));
+	}
+	params_ptr->clear();
+	MySQLParameterHandles::Add(std::move(params_ptr));
+	return gstate.params;
+}
+
+static void StoreProcedureResult(MYSQL_STMT *stmt, const string &query) {
+	bool btrue = true;
+	auto res_attr = mysql_stmt_attr_set(stmt, STMT_ATTR_UPDATE_MAX_LENGTH, &btrue);
+	if (res_attr != 0) {
+		throw IOException("Failed to set STMT_ATTR_UPDATE_MAX_LENGTH for MySQL query \"%s\": %s\n", query.c_str(),
+		                  mysql_stmt_error(stmt));
+	}
+	int res_store = mysql_stmt_store_result(stmt);
+	if (res_store != 0) {
+		throw IOException("Failed to store result for MySQL query \"%s\": %s\n", query.c_str(),
+		                  mysql_stmt_error(stmt));
+	}
+}
+
+static void DrainProcedureResults(MYSQL_STMT *stmt, const string &query) {
+	if (!stmt) {
+		return;
+	}
+	mysql_stmt_free_result(stmt);
+	while (true) {
+		int next_result = mysql_stmt_next_result(stmt);
+		if (next_result > 0) {
+			throw IOException("Failed to fetch next MySQL result for query \"%s\": %s\n", query.c_str(),
+			                  mysql_stmt_error(stmt));
+		}
+		if (next_result < 0) {
+			break;
+		}
+		auto affected_rows = mysql_stmt_affected_rows(stmt);
+		if (affected_rows == static_cast<idx_t>(-1)) {
+			StoreProcedureResult(stmt, query);
+		}
+		mysql_stmt_free_result(stmt);
+	}
+}
+
+static void DrainProcedureResultsNoThrow(MYSQL_STMT *stmt, const string &query) {
+	if (!stmt) {
+		return;
+	}
+	try {
+		DrainProcedureResults(stmt, query);
+	} catch (...) {
+		// suppress
+	}
+}
